<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SoundOff.Desktop"
        x:Class="SoundOff.Desktop.MainWindow" Title="SoundOff"
        Width="1360" Height="880" MinWidth="900" MinHeight="620"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <!-- ================================================================
         Top bar. Left: what this is and the edits you take back. Centre: the
         one mode switch. Right: the panes and the preferences.
         ================================================================ -->
    <Border Classes="topbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button x:Name="ProjectMenuButton" Classes="quiet identity" AutomationProperties.Name="Project menu"
                  ToolTip.Tip="Open, create and bundle projects">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Classes="glyph volume" Width="14" Height="14" />
              <PathIcon Classes="small chevron" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="OpenProjectItem" Header="Open project…" />
                <MenuItem x:Name="RecentMenu" Header="Open recent" />
                <Separator />
                <MenuItem x:Name="DemoItem" Header="New demo project…" />
                <Separator />
                <MenuItem x:Name="ImportBundleItem" Header="Import bundle…" />
                <MenuItem x:Name="ExportBundleItem" Header="Export bundle…" />
                <Separator />
                <!-- Not an action: which build this is, so a report can say. -->
                <MenuItem x:Name="VersionItem" IsEnabled="False" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBox x:Name="TitleInput" Classes="title" MaxLength="200" Watermark="Project title" IsUndoEnabled="False"
                   IsVisible="False" MinWidth="130" MaxWidth="340" VerticalAlignment="Center"
                   AutomationProperties.Name="Project title" ToolTip.Tip="Rename this project" />
          <!-- The editor's "this has changed" mark, where the eye already is: beside the document's name. -->
          <Ellipse x:Name="DirtyDot" Classes="dirty" IsVisible="False" VerticalAlignment="Center"
                   ToolTip.Tip="Unsaved changes" AutomationProperties.Name="Unsaved changes" />
          <!-- Nothing to undo, redo or save before there is a project, so none of it is shown. -->
          <StackPanel x:Name="EditTools" Orientation="Horizontal" Spacing="2" IsVisible="False">
            <Border Classes="divider" />
            <Button x:Name="UndoButton" Classes="quiet icon" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
              <PathIcon Classes="glyph undo" />
            </Button>
            <Button x:Name="RedoButton" Classes="quiet icon" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
              <PathIcon Classes="glyph redo" />
            </Button>
            <Button x:Name="SaveButton" Content="Save" Classes="accent" Margin="6,0,0,0" ToolTip.Tip="Save (Ctrl+S)" />
            <!-- Discard appears only while there is a draft to discard. -->
            <Button x:Name="DiscardButton" Content="Discard" Classes="quiet" IsVisible="False"
                    ToolTip.Tip="Throw away unsaved changes" />
          </StackPanel>
        </StackPanel>

        <Border x:Name="ViewSwitch" Grid.Column="1" Classes="segmented" HorizontalAlignment="Center"
                VerticalAlignment="Center" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="DocumentViewButton" Classes="seg" Content="Document" IsChecked="True"
                          ToolTip.Tip="Read and correct the words (Ctrl+1)" AutomationProperties.Name="Document view" />
            <ToggleButton x:Name="TimingsViewButton" Classes="seg" Content="Timings"
                          ToolTip.Tip="Speakers and timecodes, one row per paragraph (Ctrl+2)" AutomationProperties.Name="Timings view" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- A take in progress is visible whatever else is on screen, with the one action it needs. -->
          <Border x:Name="RecordingPill" Classes="recpill" IsVisible="False" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse x:Name="RecordingPillDot" Classes="rec" VerticalAlignment="Center" />
              <TextBlock x:Name="RecordingPillText" Classes="clock" FontSize="13" VerticalAlignment="Center" />
              <Button x:Name="RecordingPillStop" Classes="quiet" Content="Stop" Padding="8,2" MinHeight="24" Height="24"
                      ToolTip.Tip="Stop and keep the recording" AutomationProperties.Name="Stop recording" />
            </StackPanel>
          </Border>
          <ToggleButton x:Name="FindToggle" Classes="subtle icon" ToolTip.Tip="Find and replace (Ctrl+F)"
                        AutomationProperties.Name="Find and replace" IsVisible="False">
            <PathIcon Classes="glyph search" />
          </ToggleButton>
          <Button x:Name="ExportMenuButton" Classes="quiet icon" AutomationProperties.Name="Export menu" ToolTip.Tip="Export and copy"
                  IsVisible="False">
            <PathIcon Classes="glyph export" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="ExportDocumentItem" Header="Document (.txt, no timestamps)…" />
                <MenuItem x:Name="CopyDocumentItem" Header="Copy document (no timestamps)" />
                <Separator />
                <MenuItem x:Name="ExportTextItem" Header="Transcript with timestamps (.txt)…" />
                <MenuItem x:Name="ExportSrtItem" Header="Subtitles (.srt)…" ToolTip.ShowOnDisabled="True" />
                <Separator />
                <MenuItem x:Name="CopyTextItem" Header="Copy transcript with timestamps" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border x:Name="PanelDivider" Classes="divider" IsVisible="False" />
          <ToggleButton x:Name="SidebarToggle" Classes="subtle icon" IsChecked="True" IsVisible="False"
                        ToolTip.Tip="Hide the side panel (Ctrl+B)" AutomationProperties.Name="Show or hide the side panel">
            <PathIcon Classes="glyph panel" />
          </ToggleButton>
          <Button x:Name="HelpButton" Content="?" Classes="quiet icon" ToolTip.Tip="Help (F1)" AutomationProperties.Name="Help" />
          <Button x:Name="SettingsButton" Classes="quiet icon" AutomationProperties.Name="Settings">
            <PathIcon Classes="glyph settings" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="18" Width="272" Margin="0,2,2,2">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Appearance" Classes="section" />
                      <ComboBox x:Name="ThemeChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Appearance">
                        <ComboBoxItem>Follow system</ComboBoxItem><ComboBoxItem>Light</ComboBoxItem><ComboBoxItem>Dark</ComboBoxItem>
                      </ComboBox>
                      <CheckBox x:Name="ReducedMotionChoice" Content="Reduced motion" IsChecked="True" AutomationProperties.Name="Reduced motion" />
                      <CheckBox x:Name="FillWindowChoice" Content="Fill the window" AutomationProperties.Name="Fill the window"
                                ToolTip.Tip="Let the document use the whole width instead of a reading measure" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Editing" Classes="section" />
                      <CheckBox x:Name="AutoSaveChoice" Content="Save automatically" IsChecked="True" AutomationProperties.Name="Save automatically"
                                ToolTip.Tip="Save a revision whenever you pause. Each one is in History, and Undo steps back through them." />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Transcription" Classes="section" />
                      <ComboBox x:Name="LanguageChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Spoken language">
                        <ComboBoxItem>Detect language</ComboBoxItem><ComboBoxItem>English</ComboBoxItem><ComboBoxItem>Filipino</ComboBoxItem>
                      </ComboBox>
                      <ComboBox x:Name="DeviceChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Processing device">
                        <ComboBoxItem>Process on the CPU</ComboBoxItem><ComboBoxItem>Process on the GPU</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>


                    <StackPanel x:Name="VideoSettings" Spacing="8" IsVisible="False">
                      <TextBlock Text="Video preview" Classes="section" />
                      <Slider x:Name="VideoSizeSlider" Minimum="120" Maximum="420" Value="220" SmallChange="20" LargeChange="40"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Video preview height" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================================
         Work area: transcript, a drag handle, the tool panel.
         ================================================================ -->
    <Grid x:Name="WorkArea" Grid.Row="1" ColumnDefinitions="*,Auto,320">
      <!-- Column 1 is closed until a video docks into it beside the transcript. -->
      <Grid x:Name="ReviewArea" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">

        <StackPanel x:Name="VideoPreviewPanel" IsVisible="False" Spacing="4" Margin="24,14,24,0" HorizontalAlignment="Center"
                    VerticalAlignment="Top">
          <Border x:Name="VideoSurface" Height="220" Background="Black" CornerRadius="8" ClipToBounds="True">
            <Image x:Name="VideoPreviewImage" Stretch="Uniform" AutomationProperties.Name="Imported video frame at the audio playhead" />
          </Border>
          <TextBlock x:Name="VideoPreviewStatus" TextWrapping="Wrap" Classes="muted" MaxWidth="520" />
        </StackPanel>

        <!-- The columns come from CueColumns in code, so the headings cannot drift from the cells. -->
        <Border x:Name="CueHeader" Grid.Row="1" Classes="cuehead" IsVisible="False">
          <Grid x:Name="CueHeaderGrid">
            <TextBlock Text="#" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Start" Margin="6,0,0,0" />
            <TextBlock Grid.Column="2" Text="End" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="Length" Margin="9,0,0,0" />
            <TextBlock Grid.Column="4" Text="Speaker" Margin="14,0,0,0" />
            <TextBlock Grid.Column="5" Text="Text" Margin="14,0,0,0" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Button x:Name="CollapseSectionsButton" Classes="quiet icon" Width="29" Height="24"
                      ToolTip.Tip="One line per paragraph" AutomationProperties.Name="Collapse all paragraphs">
                <PathIcon Classes="small collapse" />
              </Button>
              <Button x:Name="ExpandSectionsButton" Classes="quiet icon" Width="29" Height="24"
                      ToolTip.Tip="Full text of every paragraph" AutomationProperties.Name="Expand all paragraphs">
                <PathIcon Classes="small expand" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Padding="0">
          <!-- Matching the viewport height makes the page reach the bottom of the window the way paper fills a
               desk, while a long transcript still grows past it and scrolls. -->
          <Grid MinHeight="{Binding $parent[ScrollViewer].Bounds.Height}">
            <Border x:Name="DocumentPage" Classes="page">
              <StackPanel x:Name="DocumentHost" Spacing="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
            </Border>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="StartScreen" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <!-- Matching the viewport height lets the panel sit centred in an empty window while a long
               recent list still grows past it and scrolls. -->
          <Grid MinHeight="{Binding $parent[ScrollViewer].Bounds.Height}">
            <StackPanel MaxWidth="760" Spacing="28" Margin="32" HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="17" HorizontalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}">
                  <PathIcon Classes="volume" Width="26" Height="26" Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
                <TextBlock Text="SoundOff" Classes="heading" HorizontalAlignment="Center" />
                <TextBlock Text="Turn a recording into a document. On this computer." Classes="muted" FontSize="14"
                           HorizontalAlignment="Center" TextAlignment="Center" />
              </StackPanel>

              <!-- The two ways in, side by side and the same size: bring a file, or make one. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="tile drop">
                  <StackPanel Spacing="14">
                    <Border Classes="tileicon"><PathIcon Classes="export" Width="20" Height="20" /></Border>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Transcribe a file" Classes="tiletitle" />
                      <TextBlock Text="Audio or video. Drop it anywhere on this window, or choose it." Classes="muted"
                                 TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                    <Button x:Name="StartImportButton" Content="Choose a file…" Classes="accent" HorizontalAlignment="Left"
                            IsDefault="True" ToolTip.Tip="Drop a file on this window too" />
                  </StackPanel>
                </Border>
                <Border x:Name="StartRecordTile" Grid.Column="1" Classes="tile">
                  <StackPanel Spacing="14">
                    <Border Classes="tileicon rec"><PathIcon Classes="mic" Width="20" Height="20" /></Border>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Record" Classes="tiletitle" />
                      <TextBlock x:Name="RecordTileText" Text="A microphone, the computer's own sound, or both at once." Classes="muted"
                                 TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                    <!-- The recorder itself lives here until there is a project, then moves to the Audio card. -->
                    <ContentControl x:Name="StartRecordHost" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,-12,0,0">
                <Button x:Name="StartOpenButton" Content="Open a project…" Classes="quiet" />
                <TextBlock Text="·" Classes="muted" VerticalAlignment="Center" />
                <Button x:Name="StartDemoButton" Content="Try a demo" Classes="quiet" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Recent" Classes="section" Margin="12,0,0,0" />
                <StackPanel x:Name="RecentHost" Spacing="2" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <!-- A project with no transcript yet: the next step is offered where the transcript will appear, and its
             progress is shown there too, rather than in a side panel the eye has no reason to visit. -->
        <Border x:Name="EmptyTranscript" Grid.Row="2" Classes="emptystate" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14" Width="400">
            <Border Classes="tileicon" HorizontalAlignment="Center"><PathIcon Classes="document" Width="20" Height="20" /></Border>
            <StackPanel Spacing="6">
              <TextBlock Text="No transcript yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyHint" Classes="muted" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button x:Name="EmptyTranscribeButton" Classes="accent" Content="Transcribe" MinWidth="150"
                      AutomationProperties.Name="Transcribe the recording" ToolTip.ShowOnDisabled="True" />
              <Button x:Name="EmptyCancelButton" Classes="quiet" Content="Cancel" IsVisible="False"
                      AutomationProperties.Name="Cancel transcription" />
              <Button x:Name="EmptyImportButton" Classes="accent" Content="Import audio or video…" IsVisible="False"
                      AutomationProperties.Name="Import audio or video for this project" />
            </StackPanel>
            <ProgressBar x:Name="EmptyProgress" Minimum="0" Maximum="1" Height="4" IsVisible="False"
                         AutomationProperties.Name="Transcription progress" />
            <TextBlock x:Name="EmptyJobText" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" IsVisible="False" />
          </StackPanel>
        </Border>

        <!-- Floated over the transcript rather than pushing it down: opening Find must not move the
             paragraph being read. -->
        <Border x:Name="FindBar" Grid.Row="2" Classes="findbar" IsVisible="False" Margin="24,12,24,0" MaxWidth="720"
                HorizontalAlignment="Right" VerticalAlignment="Top">
          <Grid ColumnDefinitions="*,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto,Auto">
            <TextBox x:Name="FindInput" Watermark="Find" AutomationProperties.Name="Find text" IsUndoEnabled="False" MinWidth="150" />
            <TextBox x:Name="ReplaceInput" Grid.Column="1" Watermark="Replace with" AutomationProperties.Name="Replace with" IsUndoEnabled="False" MinWidth="150" />
            <Button x:Name="FindNextButton" Grid.Column="2" Content="Next" ToolTip.Tip="Find next (F3)" />
            <Button x:Name="ReplaceButton" Grid.Column="3" Content="Replace" Classes="quiet" AutomationProperties.Name="Replace selected" />
            <Button x:Name="ReplaceAllButton" Grid.Column="4" Content="All" Classes="quiet" AutomationProperties.Name="Replace all" ToolTip.Tip="Replace every match in the draft" />
            <Button x:Name="CloseFindButton" Grid.Column="5" Content="✕" Classes="quiet icon" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close find" />
            <TextBlock x:Name="FindStatus" Grid.Row="1" Grid.ColumnSpan="6" Classes="muted" Margin="2,6,0,0" />
          </Grid>
        </Border>
      </Grid>

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Classes="vertical" ResizeDirection="Columns"
                    AutomationProperties.Name="Resize the side panel" />

      <ScrollViewer x:Name="Sidebar" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" Padding="0,16,6,24">
        <StackPanel Spacing="12">
          <Border Classes="card"><StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Audio" Classes="section" VerticalAlignment="Center" />
              <Button x:Name="ImportMediaButton" Grid.Column="1" Content="Import…" Classes="quiet" ToolTip.Tip="Import audio or video" />
            </Grid>
            <!-- The file this project is about: what it is and how long, as a row rather than a sentence. -->
            <Border x:Name="MediaRow" Classes="mediarow" IsVisible="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="mediaicon"><PathIcon x:Name="MediaIcon" Classes="wave" Width="16" Height="16" /></Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock x:Name="MediaText" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="MediaDetail" Classes="muted" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- Recording is chosen per take, so it stays in reach — but folded away once there is audio to work on. -->
            <ToggleButton x:Name="NewTakeToggle" Classes="disclosure" IsVisible="False" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Record a new take">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <PathIcon Classes="mic" Width="14" Height="14" />
                <TextBlock Grid.Column="1" Text="Record a new take" VerticalAlignment="Center" />
                <PathIcon x:Name="NewTakeChevron" Grid.Column="2" Classes="small expand" />
              </Grid>
            </ToggleButton>
            <ContentControl x:Name="CardRecordHost">
              <StackPanel x:Name="RecordPanel" Spacing="10">
                <!-- What to record and on which device stay in reach: they are chosen before a take, not once. -->
                <ComboBox x:Name="CaptureModeChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="What to record">
                  <ComboBoxItem>Microphone</ComboBoxItem><ComboBoxItem>Whole computer</ComboBoxItem><ComboBoxItem>Microphone + whole computer</ComboBoxItem>
                </ComboBox>
                <ComboBox x:Name="CaptureDeviceChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Recording device" />
                <StackPanel x:Name="CaptureRenderPanel" IsVisible="False" Spacing="6">
                  <TextBlock Text="Computer audio" Classes="muted" />
                  <ComboBox x:Name="CaptureRenderChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Computer audio render endpoint" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <Button x:Name="RecordButton" Classes="record" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Classes="rec" VerticalAlignment="Center" />
                      <TextBlock x:Name="RecordButtonText" Text="Record" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="PauseRecordButton" Grid.Column="1" Content="Pause" Classes="quiet" />
                  <Button x:Name="StopRecordButton" Grid.Column="2" Content="Stop" Classes="quiet" />
                </Grid>
                <ProgressBar x:Name="LevelMeter" Classes="level" Minimum="0" Maximum="1" Height="6" IsVisible="False" AutomationProperties.Name="Input level" />
                <TextBlock x:Name="RecordText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
              </StackPanel>
            </ContentControl>
          </StackPanel></Border>

          <Border x:Name="TranscribeCard" Classes="card"><StackPanel Spacing="10">
            <TextBlock Text="Transcribe" Classes="section" />
            <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
            <Button x:Name="PreparePackButton" Content="Prepare model pack" IsVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <Button x:Name="TranscribeButton" Classes="accent" Content="Transcribe" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.ShowOnDisabled="True" />
              <Button x:Name="CancelRunButton" Grid.Column="1" Content="Cancel" Classes="quiet" IsVisible="False" />
            </Grid>
            <ProgressBar x:Name="JobProgressBar" Minimum="0" Maximum="1" Height="4" IsVisible="False" AutomationProperties.Name="Job progress" />
            <TextBlock x:Name="JobText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
            <Button x:Name="ApplyResultButton" Content="Apply result" IsVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Expander x:Name="RunsExpander" Header="Previous runs" IsVisible="False" HorizontalAlignment="Stretch">
              <StackPanel x:Name="RunHost" Spacing="6" />
            </Expander>
          </StackPanel></Border>

          <Border x:Name="SpeakersCard" Classes="card" IsVisible="False"><StackPanel Spacing="10">
            <TextBlock Text="Speakers" Classes="section" />
            <StackPanel x:Name="SpeakerHost" Spacing="6" />
          </StackPanel></Border>

          <Border x:Name="HistoryCard" Classes="card" IsVisible="False">
            <Expander Header="History" HorizontalAlignment="Stretch">
              <StackPanel x:Name="HistoryHost" Spacing="4" />
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Dragged rather than split: the transport's own height varies with what it has to say, so the handle
         sets the waveform's height directly instead of a grid row's. -->
    <Border x:Name="TransportHandle" Grid.Row="2" Classes="handle" IsVisible="False" Cursor="SizeNorthSouth"
            AutomationProperties.Name="Drag to resize the waveform" ToolTip.Tip="Drag to resize the waveform" />

    <!-- ================================================================
         Transport. The waveform takes whatever height the splitter gives it.
         ================================================================ -->
    <Border Grid.Row="3" x:Name="TransportBar" Classes="transport" IsVisible="False">
      <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
        <Border x:Name="WaveformHost" Classes="waveform" IsVisible="False" MinHeight="56">
          <Panel>
            <controls:WaveformOverview x:Name="Waveform" AutomationProperties.Name="Recording waveform. Click to move the playhead"
                                       ToolTip.Tip="Click or drag to move the playhead · double-click to play from there · scroll to zoom · Shift+scroll to slide along" />
            <TextBlock x:Name="WaveformStatus" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="8,0" IsVisible="False" />
          </Panel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
          <Button x:Name="SkipBackButton" Classes="quiet icon" ToolTip.Tip="Back 5 seconds (F8)" AutomationProperties.Name="Skip back five seconds">
            <PathIcon Classes="glyph back5" />
          </Button>
          <Button x:Name="PlayPauseButton" Grid.Column="1" Classes="accent round" AutomationProperties.Name="Play" ToolTip.Tip="Play (Ctrl+Space)" />
          <Button x:Name="SkipForwardButton" Grid.Column="2" Classes="quiet icon" ToolTip.Tip="Forward 5 seconds (F9)" AutomationProperties.Name="Skip forward five seconds">
            <PathIcon Classes="glyph forward5" />
          </Button>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="PositionText" Classes="clock" FontSize="13" VerticalAlignment="Center" MinWidth="104" Margin="6,0,2,0" />
            <!-- How fast to listen. Pitch is kept, so a voice stays itself at any of these. -->
            <Button x:Name="SpeedButton" Classes="quiet speed" Content="1×" AutomationProperties.Name="Playback speed"
                    ToolTip.Tip="Playback speed · Ctrl+Shift+, slower · Ctrl+Shift+. faster">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft" />
              </Button.Flyout>
            </Button>
          </StackPanel>
          <Slider x:Name="PositionSlider" Grid.Column="4" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center" AutomationProperties.Name="Playback position" />
          <!-- Zoom belongs to the waveform but sits with the other transport controls, so the strip keeps its full width. -->
          <StackPanel x:Name="ZoomControls" Grid.Column="5" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="4,0">
            <Button x:Name="ZoomOutButton" Classes="quiet icon" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom waveform out">
              <PathIcon Classes="glyph minus" />
            </Button>
            <Button x:Name="FitWaveButton" Classes="quiet" Content="Fit" MinHeight="0" Height="30" Padding="8,0"
                    ToolTip.Tip="Show the whole recording" AutomationProperties.Name="Fit the whole recording in the waveform" />
            <Button x:Name="ZoomInButton" Classes="quiet icon" ToolTip.Tip="Zoom in — also scroll on the waveform" AutomationProperties.Name="Zoom waveform in">
              <PathIcon Classes="glyph plus" />
            </Button>
          </StackPanel>
          <WrapPanel x:Name="VideoControls" Grid.Column="6" IsVisible="False" VerticalAlignment="Center">
            <ToggleButton x:Name="VideoPreviewToggle" Classes="subtle icon" IsChecked="True"
                          AutomationProperties.Name="Show or hide video preview (audio continues)">
              <PathIcon Classes="glyph film" />
            </ToggleButton>
          </WrapPanel>
          <ToggleButton x:Name="FollowButton" Classes="subtle icon" Grid.Column="7" IsChecked="True"
                        ToolTip.Tip="Keep the playing paragraph in view" AutomationProperties.Name="Follow playback while it plays">
            <PathIcon Classes="glyph follow" />
          </ToggleButton>
          <Button x:Name="VolumeButton" Grid.Column="8" Classes="quiet icon" AutomationProperties.Name="Volume" ToolTip.Tip="Volume">
            <PathIcon Classes="glyph volume" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="1" Width="150" AutomationProperties.Name="Volume" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <TextBlock x:Name="PlaybackText" Grid.Row="2" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
      </Grid>
    </Border>

    <!-- A note that something happened: it never takes focus, never needs dismissing, and goes by itself. -->
    <Border x:Name="ToastHost" Grid.Row="1" Classes="toast" IsHitTestVisible="False" HorizontalAlignment="Center"
            VerticalAlignment="Bottom" Margin="0,0,0,20">
      <TextBlock x:Name="ToastText" />
    </Border>

    <!-- Shown only while a usable file is dragged over the window: the drop target is the whole window, and it says so. -->
    <Border x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="3" Classes="dropoverlay" IsVisible="False" IsHitTestVisible="False">
      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Classes="tileicon" HorizontalAlignment="Center"><PathIcon Classes="export" Width="22" Height="22" /></Border>
        <TextBlock x:Name="DropOverlayText" Text="Drop to import" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="The file is copied into the project; the original is not touched." Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Classes="statusbar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Ellipse x:Name="StateDot" Classes="state" VerticalAlignment="Center" AutomationProperties.Name="Project state" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="No project open" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock x:Name="PathText" Grid.Column="2" Classes="muted" TextTrimming="PathSegmentEllipsis" MaxWidth="440" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
