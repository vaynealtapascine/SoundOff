<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SoundOff.Desktop"
        x:Class="SoundOff.Desktop.MainWindow" Title="SoundOff"
        Width="1280" Height="860" MinWidth="900" MinHeight="620"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border Classes="topbar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="ProjectMenuButton" Content="Project ⌄" Classes="quiet" AutomationProperties.Name="Project menu">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="OpenProjectItem" Header="Open project…" />
                <MenuItem x:Name="RecentMenu" Header="Open recent" />
                <Separator />
                <MenuItem x:Name="DemoItem" Header="New demo project…" />
                <Separator />
                <MenuItem x:Name="ImportBundleItem" Header="Import bundle…" />
                <MenuItem x:Name="ExportBundleItem" Header="Export bundle…" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ExportMenuButton" Content="Export ⌄" Classes="quiet" AutomationProperties.Name="Export menu">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="ExportDocumentItem" Header="Document (.txt, no timestamps)…" />
                <MenuItem x:Name="CopyDocumentItem" Header="Copy document (no timestamps)" />
                <Separator />
                <MenuItem x:Name="ExportTextItem" Header="Transcript with timestamps (.txt)…" />
                <MenuItem x:Name="ExportSrtItem" Header="Subtitles (.srt)…" ToolTip.ShowOnDisabled="True" />
                <Separator />
                <MenuItem x:Name="CopyTextItem" Header="Copy transcript with timestamps" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border Classes="divider" />
          <Button x:Name="UndoButton" Classes="quiet" Content="Undo" ToolTip.Tip="Undo (Ctrl+Z)" />
          <Button x:Name="RedoButton" Classes="quiet" Content="Redo" ToolTip.Tip="Redo (Ctrl+Y)" />
          <Button x:Name="SaveButton" Content="Save" Classes="accent" ToolTip.Tip="Save (Ctrl+S)" />
          <Button x:Name="DiscardButton" Content="Discard" Classes="quiet" ToolTip.Tip="Discard unsaved changes" />
          <Border Classes="divider" />
          <ToggleButton x:Name="FindToggle" Content="Find" ToolTip.Tip="Find and replace (Ctrl+F)" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ToggleButton x:Name="SidebarToggle" Content="Tools" Classes="subtle" IsChecked="True" ToolTip.Tip="Show the side panel (Ctrl+B)"
                        AutomationProperties.Name="Show or hide the side panel" />
          <Border Classes="divider" />
          <Button x:Name="HelpButton" Content="Help" Classes="quiet" ToolTip.Tip="Help (F1)" />
          <Button x:Name="SettingsButton" Content="Settings ⌄" Classes="quiet" AutomationProperties.Name="Settings menu">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="12" MinWidth="220">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Theme" />
                    <ComboBox x:Name="ThemeChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Appearance">
                      <ComboBoxItem>Follow system</ComboBoxItem><ComboBoxItem>Light</ComboBoxItem><ComboBoxItem>Dark</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                  <CheckBox x:Name="ReducedMotionChoice" Content="Reduced motion" IsChecked="True" AutomationProperties.Name="Reduced motion" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkArea" Grid.Row="1" ColumnDefinitions="*,320" Margin="24,20,24,0" ColumnSpacing="24">
      <Grid x:Name="ReviewArea" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Border x:Name="FindBar" Classes="findbar" IsVisible="False" Margin="0,0,0,12" MaxWidth="800">
          <Grid ColumnDefinitions="*,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
            <TextBox x:Name="FindInput" Watermark="Find" AutomationProperties.Name="Find text" IsUndoEnabled="False" />
            <TextBox x:Name="ReplaceInput" Grid.Column="1" Watermark="Replace with" AutomationProperties.Name="Replace with" IsUndoEnabled="False" />
            <Button x:Name="FindNextButton" Grid.Column="2" Content="Next" ToolTip.Tip="Find next (F3)" />
            <Button x:Name="ReplaceButton" Grid.Column="3" Content="Replace" AutomationProperties.Name="Replace selected" />
            <Button x:Name="ReplaceAllButton" Grid.Column="4" Content="Replace all" />
            <Button x:Name="CloseFindButton" Grid.Column="5" Content="✕" Classes="quiet" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close find" />
            <TextBlock x:Name="FindStatus" Grid.Row="1" Grid.ColumnSpan="6" Classes="muted" Margin="2,6,0,0" />
          </Grid>
        </Border>
        <WrapPanel x:Name="VideoControls" Grid.Row="1" IsVisible="False" Orientation="Horizontal" Margin="0,0,0,8" MaxWidth="800">
          <ToggleButton x:Name="VideoPreviewToggle" Content="Hide video" IsChecked="True" Margin="0,0,12,0"
                        AutomationProperties.Name="Show or hide video preview (audio continues)" />
          <Slider x:Name="VideoSizeSlider" Minimum="120" Maximum="320" Value="200" SmallChange="20" LargeChange="40"
                  Width="120" ToolTip.Tip="Preview size" AutomationProperties.Name="Video preview height" />
        </WrapPanel>
        <StackPanel x:Name="VideoPreviewPanel" Grid.Row="2" IsVisible="False" Spacing="4" Margin="0,0,0,12" MaxWidth="800">
          <Border x:Name="VideoSurface" Height="200" Background="Black" CornerRadius="6" ClipToBounds="True">
            <Image x:Name="VideoPreviewImage" Stretch="Uniform" AutomationProperties.Name="Imported video frame at the audio playhead" />
          </Border>
          <TextBlock x:Name="VideoPreviewStatus" TextWrapping="Wrap" Classes="muted" />
        </StackPanel>
        <!-- Same 800px measure and 28px text inset as the document below it, so the view controls line up
             with the title and paragraphs rather than with the invisible column edge. -->
        <Border x:Name="ViewBar" Grid.Row="3" MaxWidth="800" Padding="28,0,0,0" Margin="0,0,0,12" IsVisible="False">
          <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="ViewChoice" SelectedIndex="0" MinWidth="150" ToolTip.Tip="Document keeps the words in focus. Timings shows speakers and timing. Switching preserves your edits." AutomationProperties.Name="Transcript view">
              <ComboBoxItem>Document</ComboBoxItem>
              <ComboBoxItem>Timings</ComboBoxItem>
            </ComboBox>
            <Button x:Name="CollapseSectionsButton" Classes="quiet" Content="Collapse all" Margin="8,0,0,0" />
            <Button x:Name="ExpandSectionsButton" Classes="quiet" Content="Expand all" Margin="6,0,0,0" />
          </WrapPanel>
        </Border>

        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="DocumentHost" Spacing="14" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,12,0,32" />
        </ScrollViewer>
        <ScrollViewer x:Name="StartScreen" Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="560" Spacing="28" Margin="0,44,0,24" HorizontalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center"
                      Background="{DynamicResource AccentSoftBrush}">
                <PathIcon Classes="volume" Width="30" Height="30" Foreground="{DynamicResource PrimaryBrush}" />
              </Border>
              <TextBlock Text="SoundOff" Classes="heading" HorizontalAlignment="Center" />
              <TextBlock Text="Turn a recording into a document. On this computer." Classes="muted" FontSize="14"
                         HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <Button x:Name="StartImportButton" Content="Import audio or video…" Classes="accent"
                      MinWidth="260" IsDefault="True" ToolTip.Tip="Drop a file on this window too" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="StartOpenButton" Content="Open project…" />
                <Button x:Name="StartDemoButton" Content="Try a demo project…" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Recent" Classes="section" />
              <StackPanel x:Name="RecentHost" Spacing="2" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <ScrollViewer x:Name="Sidebar" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,4,24">
          <Border Classes="card"><StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Audio" Classes="section" VerticalAlignment="Center" />
              <Button x:Name="ImportMediaButton" Grid.Column="1" Content="Import…" ToolTip.Tip="Import audio or video" />
            </Grid>
            <TextBlock x:Name="MediaText" TextWrapping="Wrap" IsVisible="False" />
            <ComboBox x:Name="CaptureModeChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="What to record">
              <ComboBoxItem>Microphone</ComboBoxItem><ComboBoxItem>Whole computer</ComboBoxItem><ComboBoxItem>Microphone + whole computer</ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="CaptureDeviceChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Recording device" />
            <StackPanel x:Name="CaptureRenderPanel" IsVisible="False" Spacing="4">
              <TextBlock Text="Computer audio" Classes="muted" />
              <ComboBox x:Name="CaptureRenderChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Computer audio render endpoint" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <Button x:Name="RecordButton" Content="Record" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="PauseRecordButton" Grid.Column="1" Content="Pause" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="StopRecordButton" Grid.Column="2" Content="Stop" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Grid>
            <ProgressBar x:Name="LevelMeter" Minimum="0" Maximum="1" Height="4" IsVisible="False" AutomationProperties.Name="Input level" />
            <TextBlock x:Name="RecordText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
          </StackPanel></Border>

          <Border x:Name="TranscribeCard" Classes="card"><StackPanel Spacing="10">
            <TextBlock Text="Transcribe" Classes="section" />
            <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
            <Button x:Name="PreparePackButton" Content="Prepare model pack" IsVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox x:Name="LanguageChoice" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Spoken language">
                <ComboBoxItem>Detect language</ComboBoxItem><ComboBoxItem>English</ComboBoxItem><ComboBoxItem>Filipino</ComboBoxItem>
              </ComboBox>
              <ComboBox x:Name="DeviceChoice" Grid.Column="1" SelectedIndex="0" MinWidth="84" AutomationProperties.Name="Processing device">
                <ComboBoxItem>CPU</ComboBoxItem><ComboBoxItem>GPU</ComboBoxItem>
              </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <Button x:Name="TranscribeButton" Classes="accent" Content="Transcribe" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.ShowOnDisabled="True" />
              <Button x:Name="CancelRunButton" Grid.Column="1" Content="Cancel" IsVisible="False" />
            </Grid>
            <ProgressBar x:Name="JobProgressBar" Minimum="0" Maximum="1" Height="4" IsVisible="False" AutomationProperties.Name="Job progress" />
            <TextBlock x:Name="JobText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
            <Button x:Name="ApplyResultButton" Content="Apply result" IsVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Expander x:Name="RunsExpander" Header="Previous runs" IsVisible="False" HorizontalAlignment="Stretch">
              <StackPanel x:Name="RunHost" Spacing="6" />
            </Expander>
          </StackPanel></Border>

          <Border x:Name="SpeakersCard" Classes="card" IsVisible="False"><StackPanel Spacing="10">
            <TextBlock Text="Speakers" Classes="section" />
            <StackPanel x:Name="SpeakerHost" Spacing="8" />
          </StackPanel></Border>

          <Expander x:Name="HistoryCard" Header="History" IsVisible="False" HorizontalAlignment="Stretch">
            <StackPanel x:Name="HistoryHost" Spacing="6" />
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" x:Name="TransportBar" Classes="transport" IsVisible="False">
      <StackPanel Spacing="4">
        <Border x:Name="WaveformHost" Classes="waveform" IsVisible="False" Height="72" Margin="0,0,0,10">
          <Panel>
            <controls:WaveformOverview x:Name="Waveform" Margin="0,0,100,0" AutomationProperties.Name="Recording waveform. Click to move the playhead"
                                       ToolTip.Tip="Click or drag to move the playhead. Scroll on the strip or use the zoom buttons to change the time span shown." />
            <TextBlock x:Name="WaveformStatus" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="8,0" IsVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2" Margin="0,4,6,0">
              <Button x:Name="ZoomInButton" Classes="quiet" Content="＋" Width="28" Height="26" MinHeight="0" Padding="0"
                      ToolTip.Tip="Zoom in — also scroll on the waveform" AutomationProperties.Name="Zoom waveform in" />
              <Button x:Name="ZoomOutButton" Classes="quiet" Content="－" Width="28" Height="26" MinHeight="0" Padding="0"
                      ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom waveform out" />
              <Button x:Name="FitWaveButton" Classes="quiet" Content="Fit" MinHeight="26" Height="26" Padding="8,0"
                      ToolTip.Tip="Show the whole recording" AutomationProperties.Name="Fit the whole recording in the waveform" />
            </StackPanel>
          </Panel>
        </Border>
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <Button x:Name="SkipBackButton" Classes="quiet" Content="−5s" ToolTip.Tip="Back 5 seconds" AutomationProperties.Name="Skip back five seconds" />
          <Button x:Name="PlayPauseButton" Grid.Column="1" Classes="accent round" AutomationProperties.Name="Play" ToolTip.Tip="Play" />
          <Button x:Name="SkipForwardButton" Classes="quiet" Grid.Column="2" Content="+5s" ToolTip.Tip="Forward 5 seconds" AutomationProperties.Name="Skip forward five seconds" />
          <Slider x:Name="PositionSlider" Grid.Column="3" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center" AutomationProperties.Name="Playback position" />
          <TextBlock x:Name="PositionText" Grid.Column="4" VerticalAlignment="Center" MinWidth="96" />
          <ToggleButton x:Name="FollowButton" Classes="subtle" Grid.Column="5" Content="Follow" IsChecked="True"
                        ToolTip.Tip="Keep the playing paragraph in view" AutomationProperties.Name="Follow playback while it plays" />
          <PathIcon Grid.Column="6" Width="16" Height="16" VerticalAlignment="Center" Classes="volume" />
          <Slider x:Name="VolumeSlider" Grid.Column="7" Minimum="0" Maximum="1" Value="1" Width="96" VerticalAlignment="Center" AutomationProperties.Name="Volume" ToolTip.Tip="Volume" />
        </Grid>
        <TextBlock x:Name="PlaybackText" TextWrapping="Wrap" Classes="muted" IsVisible="False" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Classes="statusbar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Ellipse x:Name="StateDot" Classes="state" VerticalAlignment="Center" AutomationProperties.Name="Project state" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="No project open" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock x:Name="PathText" Grid.Column="2" Classes="muted" TextTrimming="PathSegmentEllipsis" MaxWidth="520" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
