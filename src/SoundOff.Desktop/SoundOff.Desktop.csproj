<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SoundOff.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="NAudio.Core" Version="2.4.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.4.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <ProjectReference Include="..\SoundOff.Core\SoundOff.Core.csproj" />
    <ProjectReference Include="..\SoundOff.Protocol\SoundOff.Protocol.csproj" />
    <ProjectReference Include="..\SoundOff.Worker\SoundOff.Worker.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\..\docs\HELP.md" LogicalName="SoundOff.Desktop.HELP.md" />
  </ItemGroup>
  <Target Name="CopyInferenceWorker" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../SoundOff.Worker.Python/soundoff_worker.py" DestinationFolder="$(OutDir)worker" />
  </Target>
  <Target Name="CopyFixtureWorker" AfterTargets="Build">
    <ItemGroup><WorkerFiles Include="$(MSBuildProjectDirectory)/../SoundOff.Worker/bin/$(Configuration)/net8.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(OutDir)worker/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishFixtureWorker" AfterTargets="Publish">
    <ItemGroup><PublishWorkerFiles Include="$(OutDir)worker/**/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishWorkerFiles)" DestinationFiles="@(PublishWorkerFiles->'$(PublishDir)worker/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
