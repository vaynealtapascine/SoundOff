<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoundOff.Desktop.App" RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <!-- Real designer entry points: spacing, readable width, typography, panel width. -->
    <Style Selector="Button"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="14,8" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBox.transcript"><Setter Property="FontSize" Value="18" /><Setter Property="Padding" Value="14" /><Setter Property="MinHeight" Value="120" /></Style>
    <Style Selector="Border.card"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="20" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" /></Style>
    <!-- Playback highlighting is visual only: it changes no text, caret, selection or history. -->
    <Style Selector="Border.card.playing"><Setter Property="BorderThickness" Value="2" /><Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" /></Style>
    <Style Selector="Button.word"><Setter Property="Margin" Value="0,0,4,4" /><Setter Property="Padding" Value="6,2" /><Setter Property="MinHeight" Value="0" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button.word.current"><Setter Property="FontWeight" Value="Bold" /><Setter Property="Background" Value="{DynamicResource SystemAccentColor}" /></Style>
    <!-- Include template parts: disabling only the outer Button misses Fluent transitions. -->
    <Style Selector="Window.reducedMotion :is(Control), Window.reducedMotion :is(TemplatedControl) /template/ :is(Control)">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
  </Application.Styles>
</Application>
